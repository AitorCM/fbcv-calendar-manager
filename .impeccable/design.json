        "purpose": "Default running text at normal width."
      },
      "body-sm": {
        "displayName": "Body Small",
        "purpose": "Buttons, metadata, meta lines."
      },
      "label": {
        "displayName": "Label",
        "purpose": "Uppercase board day headings."
      },
      "tile-label": {
        "displayName": "Tile Label",
        "purpose": "Uppercase word above LED digits on time tiles."
      }
    },
    "fontLoading": {
      "package": "@fontsource-variable/archivo",
      "import": "@fontsource-variable/archivo/wdth.css",
      "axes": [
        "wght",
        "wdth"
      ]
    },
    "themes": {
      "attribute": "data-theme on <html>",
      "values": [
        "light",
        "dark"
      ],
      "storageKey": "fbcv-theme",
      "fallback": "prefers-color-scheme",
      "themeColorMeta": "#0d1117"
    },
    "shadows": [
      {
        "name": "pop",
        "value": "0 12px 32px -8px rgb(13 17 23 / 0.28), 0 2px 6px rgb(13 17 23 / 0.08)",
        "dark": "0 16px 40px -8px rgb(0 0 0 / 0.6), 0 2px 6px rgb(0 0 0 / 0.4)",
        "purpose": "Floating layers only: club switcher panel and toast."
      },
      {
        "name": "focus-halo",
        "value": "0 0 0 3px var(--accent-soft)",
        "purpose": "Search field focus-within, paired with an orange border."
      }
    ],
    "focus": [
      {
        "name": "focus-ring",
        "value": "outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 4px",
        "purpose": "Global :focus-visible. Rows use offset -2px; selects/date/textarea use offset 0 plus an orange border."
      }
    ],
    "motion": [
      {
        "name": "state-transition",
        "value": "150ms ease-out",
        "purpose": "Background, border and colour changes on buttons, rows, chips, inputs."
      },
      {
        "name": "ease-out-expo",
        "value": "cubic-bezier(0.16, 1, 0.3, 1)",
        "purpose": "Entrances: switcher pop-in (160ms, from -6px) and toast rise (200ms, from +8px)."
      },
      {
        "name": "led-on",
        "value": "520ms steps(4, end)",
        "purpose": "One-time power-on flicker of large seven-segment digits (lit, ghost, lit)."
      },
      {
        "name": "shimmer",
        "value": "1.3s ease-in-out infinite",
        "purpose": "Skeleton loading bars."
      },
      {
        "name": "reduced-motion",
        "value": "animation/transition durations forced to 1ms",
        "purpose": "Global prefers-reduced-motion override."
      }
    ],
    "breakpoints": [
      {
        "name": "desktop",
        "value": "720px",
        "purpose": "Gutter 16px to 32px, row reflow, large digit 40px to 56px, season readout shown."
      },
      {
        "name": "two-pane",
        "value": "960px",
        "purpose": "Equipos view becomes a 300px sticky list beside the calendar."
      }
    ],
    "sevenSegment": {
      "glyphCell": "12 x 22 units, 3-unit tracking, 2.4 segment thickness, 0.5 gap, skewX(-6deg)",
      "heights": {
        "sm": "16px",
        "md": "22px",
        "lg": "40px",
        "lg-desktop": "56px"
      },
      "glyphs": "0-9, '-', ':', '.', space",
      "unlit": "var(--led-ghost)"
    },
    "iconography": {
      "grid": "20px",
      "stroke": "1.75",
      "caps": "round",
      "joins": "round",
      "default": "outline",
      "filled": "star when followed",
